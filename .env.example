# Sisters Cafe Environment Configuration
# Copy this file to .env and fill in your actual values

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Application fee percentage (e.g., 0.05 for 5%)
STRIPE_APPLICATION_FEE_PERCENT=0.05

# Email Configuration (Gmail)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Restaurant Contact Information
RESTAURANT_PHONE=+1234567890
RESTAURANT_EMAIL=sisters806@gmail.com

# Notion Configuration
NOTION_API_KEY=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Notes:
# 1. For Gmail, you need to enable 2-factor authentication and create an "App Password"
# 2. For Twilio, sign up at twilio.com and get your credentials
# 3. Restaurant phone should be in E.164 format (+1234567890)
# 4. For Notion, create an integration at https://www.notion.so/my-integrations
# 5. Share your database with the integration and copy the database ID from the URL